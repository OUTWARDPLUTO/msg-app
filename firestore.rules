rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function isUser(uid) { return isAuth() && request.auth.uid == uid; }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function userGymId() {
      let data = getUserData();
      return data != null && 'gymId' in data ? data.gymId : null;
    }

    function userRole() {
      let data = getUserData();
      return data != null && 'role' in data ? data.role : null;
    }

    function isOwnerOf(gymId) { return isAuth() && userGymId() == gymId && userRole() == 'owner'; }
    function isTrainerOf(gymId) { return isAuth() && userGymId() == gymId && userRole() == 'trainer'; }
    function isMemberOf(gymId) { return isAuth() && userGymId() == gymId; }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Users can read their own doc. They can create/update it, BUT they are strictly
    // prohibited from modifying their own 'subscription' field (only backend can do this).
    match /users/{uid} {
      allow read:   if isUser(uid);
      allow create: if isUser(uid) && !('subscription' in request.resource.data);
      allow update: if isUser(uid) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']));
      allow delete: if false;

      // Device tokens — users may only manage their own devices
      match /devices/{installationId} {
        allow read, write: if isUser(uid);
      }

      // Notification preferences — users may only manage their own preferences
      match /notificationPreferences/{docId} {
        allow read, write: if isUser(uid);
      }
    }

        // ── Gyms ──────────────────────────────────────────────────────────────────
    // Anyone authenticated can read a gym (needed for join-by-code lookup)
    // Only the gym owner can update settings
    match /gyms/{gymId} {
      allow read:   if isAuth();
      allow create: if isAuth();   // creator will be stored as ownerUid in doc
      allow update: if isOwnerOf(gymId);
      allow delete: if false;

      match /store_products/{productId} {
        allow read:   if isMemberOf(gymId) || isOwnerOf(gymId);
        allow write:  if isOwnerOf(gymId);
      }

      match /membership_plans/{planId} {
        allow read:   if isMemberOf(gymId) || isOwnerOf(gymId);
        allow write:  if isOwnerOf(gymId);
      }

      // Owner campaign records (created & read by owner, or server-managed)
      match /campaigns/{campaignId} {
        allow read:           if isOwnerOf(gymId);
        allow create, update: if isOwnerOf(gymId);
        allow delete:         if false;
      }

      // Membership event alerts (e.g. status changes, suspensions)
      match /membershipEvents/{eventId} {
        allow read, write: if isOwnerOf(gymId);
      }
    }

    // ── Trainers ──────────────────────────────────────────────────────────────
    match /gyms/{gymId}/trainers/{uid} {
      allow read:   if isOwnerOf(gymId) || isUser(uid);
      allow create: if isAuth() && isUser(uid); // Trainer applies
      allow update: if isOwnerOf(gymId); // Owner approves
      allow delete: if isOwnerOf(gymId);
    }

    // ── Member Codes (for linking) ────────────────────────────────────────────
    match /gyms/{gymId}/member_codes/{code} {
      allow read:   if isTrainerOf(gymId) || isOwnerOf(gymId) || isMemberOf(gymId);
      allow write:  if isMemberOf(gymId) || isOwnerOf(gymId);
    }

    // ── Member Score Protection Helper ───────────────────────────────────────
    function hasProtectedScoreFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'engagementScore', 'engagementBreakdown', 'engagementUpdatedAt', 'engagementStatus', 'engagementStatusKey'
      ]);
    }

    // ── Members ───────────────────────────────────────────────────────────────
    // Members can read their own doc; owners can read/write all members in their gym
    // Trainers can only list their assigned members, or read unassigned members during linking
    // Only Firebase Admin backend logic can write protected engagementScore / breakdown fields
    match /members/{docId} {
      // docId is "{gymId}_{uid}"
      allow get:    if isAuth() && (
                      resource == null ||
                      isUser(resource.data.uid) ||
                      isOwnerOf(resource.data.gymId) ||
                      (isTrainerOf(resource.data.gymId) && (
                        resource.data.trainerUid == request.auth.uid ||
                        !('trainerUid' in resource.data) ||
                        resource.data.trainerUid == null
                      ))
                    );
      allow list:   if isAuth() && (
                      isUser(resource.data.uid) ||
                      isOwnerOf(resource.data.gymId) ||
                      (isTrainerOf(resource.data.gymId) && resource.data.trainerUid == request.auth.uid)
                    );
      allow create: if isAuth() && !request.resource.data.keys().hasAny([
                      'engagementScore', 'engagementBreakdown', 'engagementUpdatedAt', 'engagementStatus', 'engagementStatusKey'
                    ]);
      allow update: if isAuth() && !hasProtectedScoreFields() && (
                      isUser(resource.data.uid) ||
                      isOwnerOf(resource.data.gymId) ||
                      (isTrainerOf(resource.data.gymId) && (
                        resource.data.trainerUid == request.auth.uid ||
                        !('trainerUid' in resource.data) ||
                        resource.data.trainerUid == null
                      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'trainerUid', 'coachingNotes', 'workoutPlanText'
                      ]))
                    );
      allow delete: if isOwnerOf(resource.data.gymId);
    }

    // ── Attendance ────────────────────────────────────────────────────────────
    match /attendance/{gymId}/logs/{logId} {
      allow read:   if isOwnerOf(gymId) || (isMemberOf(gymId) && isUser(resource.data.uid)) || isTrainerOf(gymId);
      allow create: if isMemberOf(gymId) && isUser(request.resource.data.uid);
      allow update: if false;
      allow delete: if false;
    }

    // ── Activity Logs ─────────────────────────────────────────────────────────
    // Strictly validated client events: only self-logging in user's own gym,
    // narrow type/point constraints, deterministic ID format, and immutable log records.
    match /activityLogs/{gymId}/events/{eventId} {
      allow read:   if isOwnerOf(gymId) ||
                       (isMemberOf(gymId) && isUser(resource.data.uid)) ||
                       isTrainerOf(gymId);
      allow create: if isMemberOf(gymId) &&
                       isUser(request.resource.data.uid) &&
                       request.resource.data.gymId == gymId &&
                       request.resource.data.type in ['workout', 'diet', 'checkin', 'progress'] &&
                       request.resource.data.points is number &&
                       request.resource.data.points >= 1 && request.resource.data.points <= 10 &&
                       request.resource.data.timestamp != null &&
                       eventId.matches('^[a-zA-Z0-9_-]{5,100}$');
      allow update: if false;
      allow delete: if false;
    }

    // ── Chats (Disabled / Locked down) ───────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if false;
      match /{allSubcollections=**} {
        allow read, write: if false;
      }
    }

    // ── Notification Delivery History (server-written only, owner read-only) ──
    match /notifDelivery/{gymId}/logs/{logId} {
      allow read:  if isOwnerOf(gymId);
      allow write: if false;
    }

    // ── Idempotency Keys (server-only) ────────────────────────────────────────
    match /idempotency/{key} {
      allow read, write: if false;
    }
  }
}
