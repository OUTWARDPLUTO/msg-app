{
  "$schema": "https://capacitorjs.com/docs/schema/config.v0.schema.json",
  "appId": "com.msg.app",
  "appName": "MSG",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "buildOptions": {
      "keystorePath": null,
      "keystoreAlias": null
    },
    "minWebViewVersion": 60
